# The decision API (any service that speaks the chat-completions format; see README → "The decision API client")
API_BASE_URL=https://api.meta.ai/v1
API_MODEL= muse-spark-1.3
API_KEY= [API_KEY]  # your API key for the decision API service

# Optional
# API_ADAPTER=chat_completions        # chat_completions | anthropic_messages | generic_json
# API_TIMEOUT_S=60
# API_TEMPERATURE=0.2
# API_JSON_MODE=1                      # ask for a JSON-only reply (response_format) where the API supports it
# API_RETRIES=3                        # retries on timeouts, HTTP 429 and 5xx (exponential backoff)
# API_FALLBACK=hold                    # hold | builtin: what happens when a call fails after the repair attempt
# API_MAX_CALLS_PER_DAY=6              # per simulated day
# API_MAX_CALLS_PER_SEASON=600
# API_MAX_CALLS_PER_REAL_HOUR=240
# API_PRICE_IN_PER_M=3.0               # US$ per million input tokens, only for cost estimates
# API_PRICE_OUT_PER_M=15.0             # US$ per million output tokens
